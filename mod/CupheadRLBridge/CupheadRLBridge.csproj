<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 5 plugin for Cuphead (Unity 2017.4, Mono, .NET 3.5 profile).
       Build:  dotnet build -c Release  (copies the DLL into the game's BepInEx/plugins when it exists)
       Override the game path with -p:CupheadDir=... -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CupheadRLBridge</AssemblyName>
    <RootNamespace>CupheadRLBridge</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CupheadDir Condition="'$(CupheadDir)' == ''">E:\SteamLibrary\steamapps\common\Cuphead</CupheadDir>
    <Managed>$(CupheadDir)\Cuphead_Data\Managed</Managed>
    <BepInExCore>$(CupheadDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(Managed)\Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(Managed)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(CupheadDir)\BepInEx')">
    <MakeDir Directories="$(CupheadDir)\BepInEx\plugins\CupheadRLBridge" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CupheadDir)\BepInEx\plugins\CupheadRLBridge" />
  </Target>

</Project>
